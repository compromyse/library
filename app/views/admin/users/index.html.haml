- content_for :title, "Users"
.flex.items-center.justify-between.mb-8
  %h1.text-3xl.font-bold.text-gray-900 Users
  = link_to "Add User", new_admin_user_path, class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 transition-colors"

= form_with url: admin_users_path, method: :get, class: "mb-8" do |f|
  = f.text_field :q, value: params[:q], placeholder: "Search by name or email",
      class: "w-full px-4 py-3 text-xl border-2 border-gray-400 focus:border-gray-900 focus:outline-none"

- if @users.any?
  .space-y-2
    - @users.each do |user|
      .flex.flex-col.sm:flex-row.sm:items-center.sm:justify-between.gap-3.px-6.py-5.border-2{class: (user.denied? ? "border-red-600" : "border-gray-900")}
        .space-y-1
          %p.text-2xl.font-bold.text-gray-900= user.name
          %p.text-lg.text-gray-500= [ user.email, user.status.humanize, (user.admin? ? "Admin" : nil) ].compact.join(" · ")
        .flex.flex-col.sm:flex-row.gap-3.w-full.sm:w-auto
          - unless user.admin?
            - if user.pending?
              = button_to "Approve", approve_admin_user_path(user), method: :patch,
                  class: "w-full sm:w-auto text-center px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors",
                  form: { class: "w-full sm:w-auto sm:shrink-0" }
              = button_to "Deny", deny_admin_user_path(user), method: :patch,
                  class: "w-full sm:w-auto text-center px-6 py-3 text-lg font-medium text-red-700 underline bg-transparent border-0 cursor-pointer",
                  form: { class: "w-full sm:w-auto sm:shrink-0" }
            - elsif user.denied?
              = button_to "Approve", approve_admin_user_path(user), method: :patch,
                  class: "w-full sm:w-auto text-center px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors",
                  form: { class: "w-full sm:w-auto sm:shrink-0" }
            - elsif user.approved?
              = button_to "Undo Approve", unapprove_admin_user_path(user), method: :patch,
                  class: "w-full sm:w-auto text-center px-6 py-3 text-lg font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer",
                  form: { class: "w-full sm:w-auto sm:shrink-0" }
          = link_to "Edit", edit_admin_user_path(user),
              class: "w-full sm:w-auto text-center px-6 py-3 text-lg font-medium text-gray-900 underline"
- else
  %p.text-xl.text-gray-500 No users found.

- if @pagy.pages > 1
  .flex.items-center.gap-6.mt-8.text-lg
    - if @pagy.prev
      = link_to "← Previous", admin_users_path(page: @pagy.prev, q: params[:q]), class: "font-medium text-gray-900 underline"
    - else
      %span.text-gray-400 ← Previous
    %span.text-gray-600= "Page #{@pagy.page} of #{@pagy.pages}"
    - if @pagy.next
      = link_to "Next →", admin_users_path(page: @pagy.next, q: params[:q]), class: "font-medium text-gray-900 underline"
    - else
      %span.text-gray-400 Next →
